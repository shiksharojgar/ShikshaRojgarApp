rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // COMMON FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function configuredAdminUid() {
      return "PfpAI3BR2XfihY4t4B5ldInDBg72";
    }

    function isAdmin() {
  return signedIn() && (
    request.auth.uid == configuredAdminUid() ||
    get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.admin == true ||
    get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.isAdmin == true ||
    get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.role == "admin"
  );
}

    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      allow read: if signedIn() &&
        (
          request.auth.uid == uid ||
          resource.data.uid == request.auth.uid
        );

      allow write: if false;
    }


    // =====================================================
    // CHANNEL CONFIG
    // =====================================================

    match /channel_config/main {

      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() ||
        (
          signedIn() &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'followerCount',
              'totalLikes',
              'totalComments',
              'totalPostViews',
              'totalPostShares',
              'totalAppUsers',
              'totalActiveUserDays'
            ])
        );
    }


    // =====================================================
    // CHANNEL MEDIA
    // Firestore Blob based storage
    // =====================================================

    match /channel_media/{mediaId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();

      match /chunks/{chunkId} {

        allow read: if true;

        allow create, update, delete: if isAdmin();
      }
    }


    // =====================================================
    // HOME PAGES
    // Content pages such as:
    // Syllabus / Study Material / Career Guide etc.
    // =====================================================

    match /home_pages/{pageId} {

      allow read: if true;

      allow create, update, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == configuredAdminUid()
        );
    }

    // =====================================================
    // HOME NOTICES
    // Notice / Update button content
    // =====================================================

    match /home_notices/{noticeId} {

      // सभी app users Notice पढ़ सकते हैं
      allow read: if true;

      // केवल Admin Notice बना/बदल/हटा सकता है
      allow create, update, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == configuredAdminUid()
        );
    }
    // =====================================================
    // HOME CATEGORIES
    // Dynamic Home menu/category management
    // =====================================================

    match /home_categories/{categoryId} {

      // App users can read Home categories
      allow read: if true;

      // Only admin can add/edit/delete categories
      allow create, update, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == configuredAdminUid()
        );
    }


    // =====================================================
    // HOME SUB-CATEGORIES
    //
    // Example:
    // home_subcategories/teacher_vacancy
    //
    // Fields:
    // name
    // icon
    // url
    // pageType
    // parentId
    // position
    // enabled
    // =====================================================

    match /home_subcategories/{subCategoryId} {

      // App users can read sub-categories
      allow read: if true;

      // Only admin can add/edit/delete sub-categories
      allow create, update, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == configuredAdminUid()
        );
    }

    // =====================================================
    // COMMON CATEGORY POSTS
    // =====================================================

    match /category_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // =====================================================
    // SHIKSHA ROJGAR GROUP - SECURITY RULES
    // =====================================================
    // =====================================================
    // GROUP USER PROFILES - PRIVATE USER IDENTITY
    // =====================================================

    match /group_profiles/{uid} {

      // प्रोफ़ाइल केवल उसका मालिक या Admin पढ़ सकता है।
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      // यूज़र केवल अपनी प्रोफ़ाइल बना सकता है।
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "uid",
          "displayName",
          "email",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "email",
          "mobileNumber",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // यूज़र केवल अपना नाम और मोबाइल फ़ील्ड बदल सकता है।
      // ईमेल और UID इस नियम से नहीं बदल सकते।
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "displayName",
            "mobileNumber",
            "updatedAt"
          ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.updatedAt == request.time
        && (
          !("mobileNumber" in request.resource.data)
          || (
            request.resource.data.mobileNumber is string
            && request.resource.data.mobileNumber.size() <= 20
          )
        );

      // प्रोफ़ाइल यूज़र स्वयं डिलीट नहीं कर सकता।
      allow delete: if false;
    }
    match /group_posts/{postId} {

      // Admin सभी पोस्ट देख सकता है।
      // सामान्य यूज़र केवल अपनी पोस्ट या मंजूर पोस्ट देख सकता है।
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        )
        || (
          resource.data.status == "approved"
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt > request.time
        );

      // यूज़र केवल नई Pending पोस्ट बना सकता है।
      // वह खुद अपनी पोस्ट को Approved नहीं कर सकता।
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "uid",
          "displayName",
          "body",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "body",
          "status",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;

      // केवल Admin पोस्ट को मंजूर या रिजेक्ट कर सकता है।
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "approvedAt",
            "expiresAt"
          ])
        && (
          (
            request.resource.data.status == "approved"
            && request.resource.data.approvedAt == request.time
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
          )
          ||
          request.resource.data.status == "rejected"
        );

      // अपनी पोस्ट का मालिक या Admin पोस्ट हटा सकता है।
      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );
    }


    // =====================================================
    // GROUP REPORTS - PRIVATE COMPLAINTS
    // =====================================================

    match /group_reports/{reportId} {

      // शिकायत केवल शिकायतकर्ता और Admin पढ़ सकते हैं।
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // यूज़र केवल अपनी शिकायत भेज सकता है।
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "uid",
          "subject",
          "message",
          "suggestedSolution",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "subject",
          "message",
          "suggestedSolution",
          "postId",
          "status",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.suggestedSolution is string
        && request.resource.data.suggestedSolution.size() <= 2000
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;

      // शिकायत की स्थिति बदलने और उसे हटाने का अधिकार Admin को है।
      allow update, delete: if isAdmin();
    }
    // =====================================================
    // CHANNEL POSTS
    // =====================================================

    match /channel_posts/{postId} {

      allow read: if true;

      allow create, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == configuredAdminUid()
        );

      allow update: if isAdmin() ||
        (
          signedIn() &&

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'likeCount',
              'commentCount',
              'viewCount',
              'shareCount'
            ]) &&

          (
            request.resource.data.likeCount ==
              resource.data.likeCount + 1 ||

            request.resource.data.likeCount ==
              resource.data.likeCount - 1 ||

            request.resource.data.likeCount ==
              resource.data.likeCount
          ) &&

          (
            request.resource.data.commentCount ==
              resource.data.commentCount + 1 ||

            request.resource.data.commentCount ==
              resource.data.commentCount
          ) &&

          (
            request.resource.data.viewCount ==
              resource.data.viewCount + 1 ||

            request.resource.data.viewCount ==
              resource.data.viewCount
          ) &&

          (
            request.resource.data.shareCount ==
              resource.data.shareCount + 1 ||

            request.resource.data.shareCount ==
              resource.data.shareCount
          )
        );
    }


    // =====================================================
    // COMMENTS
    // =====================================================

    match /channel_posts/{postId}/comments/{commentId} {

      allow read: if true;

      allow create: if signedIn();

      allow update, delete: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == resource.data.uid
        );
    }


    // =====================================================
    // CHANNEL FOLLOWERS
    // =====================================================

    match /channel_followers/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create, delete: if signedIn() &&
        request.auth.uid == uid;

      allow update: if false;
    }


    // =====================================================
    // APP FIRST USE
    // =====================================================

    match /app_first_use/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create, update: if signedIn() &&
        request.auth.uid == uid;

      allow delete: if false;
    }


    // =====================================================
    // APP EVENTS
    // =====================================================

    match /app_events/{uid}/events/{eventId} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update, delete: if false;
    }


    // =====================================================
    // CHANNEL LIKES
    // =====================================================

    match /channel_likes/{postId}/users/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create, delete: if signedIn() &&
        request.auth.uid == uid;

      allow update: if false;
    }


    // =====================================================
    // POST VIEWS
    // =====================================================

    match /post_views/{postId}/users/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update, delete: if false;
    }


    // =====================================================
    // POST SHARES
    // =====================================================

    match /post_shares/{postId}/users/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update, delete: if false;
    }


    // =====================================================
    // FEED POST VIEWS
    // =====================================================

    match /feed_post_views/{postId}/users/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update, delete: if false;
    }


    // =====================================================
    // FEED POST SHARES
    // =====================================================

    match /feed_post_shares/{postId}/users/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update, delete: if false;
    }


    // =====================================================
    // APP INSTALLS
    // =====================================================

    match /app_installs/{uid} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create, update: if signedIn() &&
        request.auth.uid == uid;

      allow delete: if false;
    }


    // =====================================================
    // APP USAGE
    // =====================================================

    match /app_usage/{uid}/days/{day} {

      allow read: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == uid
        );

      allow create, update: if signedIn() &&
        request.auth.uid == uid;

      allow delete: if false;
    }
    // HEADER WEBSITE LINKS
    match /header_website_links/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // HEADER SOCIAL MEDIA LINKS
    match /header_social_links/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
