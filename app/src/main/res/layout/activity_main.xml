            <ImageView
                android:id="@+id/homeCarouselImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/home_teacher"
                android:scaleType="centerCrop"
                android:contentDescription="शिक्षा रोजगार: शिक्षक, विद्यार्थी और परीक्षा तैयारी" />

