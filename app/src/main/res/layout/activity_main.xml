    <!-- LEFT: Channel Name + Join/Follow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="90dp">

        <TextView
            android:id="@+id/channelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢  शिक्षा रोजगार चैनल"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"/>
            

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="👥 Join / Follow  •  सरकारी आदेश • निर्देश • शिक्षा • शिक्षक • विद्यार्थी •"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- RIGHT: Unread Badge + App Name -->
    <LinearLayout
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="7dp"
        android:paddingBottom="5dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">

            <TextView
                android:id="@+id/channelBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/badge_bg"
                android:visibility="gone"/>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="शिक्षा रोजगार ऐप"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"/>

    </LinearLayout>

</FrameLayout>
        <!-- Home Photo Auto Slider -->
        <FrameLayout
            android:id="@+id/homePhotoCarousel"
