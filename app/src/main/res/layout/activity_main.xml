<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1D4ED8"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

                <ImageView
            android:id="@+id/logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo"
            android:contentDescription="Shiksha Rojgar"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent" />

                <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shiksha Rojgar App"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="शिक्षा से सफलता तक, हर कदम आपके साथ!"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>

                <TextView
            android:id="@+id/loginButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="👤\nUsers Login"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:contentDescription="Users Login"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/adminPanelButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🔐"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:contentDescription="Admin Panel"
            android:clickable="true"
                        android:visibility="gone"
            android:focusable="true" />
<!-- Website Button -->
<TextView
    android:id="@+id/websiteButton"
    android:layout_width="54dp"
    android:layout_height="54dp"
    android:gravity="center"
    android:text="🌐\nWebsite"
    android:textSize="10sp"
    android:textColor="@android:color/white"
    android:contentDescription="Website"
    android:clickable="true"
    android:focusable="true" />

<!-- Contact Button -->
<TextView
    android:id="@+id/contactButton"
    android:layout_width="58dp"
    android:layout_height="54dp"
    android:gravity="center"
    android:text="🤝\nहमसे जुड़ें"
    android:textSize="10sp"
    android:textColor="@android:color/white"
    android:contentDescription="हमसे जुड़ें"
    android:clickable="true"
    android:focusable="true" />
<!-- Notification Button -->
<TextView
    android:id="@+id/notificationButton"
    android:layout_width="62dp"
    android:layout_height="54dp"
    android:gravity="center"
    android:text="🔔\nNotifications"
    android:textSize="10sp"
    android:textColor="@android:color/white"
    android:contentDescription="Notifications"
    android:clickable="true"
    android:focusable="true" />
    </LinearLayout>
<!-- Keep existing notificationButton below these buttons -->

    <LinearLayout android:layout_width="match_parent" android:layout_height="45dp"
        android:background="@color/navy" android:gravity="center_vertical"
        android:paddingStart="30dp" android:paddingEnd="55dp">
        <TextView android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="40dp"
            android:gravity="center_vertical" android:text="🔍  Shiksha Rojgar पर खोजें..."
            android:textColor="@color/text" android:textSize="14sp" android:paddingStart="14dp"
            android:background="@drawable/rounded_search_bg" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <ScrollView android:id="@+id/contentScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@color/bg">
   
            <!-- Channel Card -->
<FrameLayout
