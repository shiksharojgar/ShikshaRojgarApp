<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Shiksha Rojgar"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".WebViewActivity"
            android:exported="false" />

        <activity
            android:name=".ContentPageActivity"
            android:exported="false" />

        <service
            android:name=".ShikshaMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <activity
            android:name=".ChannelActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Existing custom App Link -->
            <intent-filter>

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="shiksharojgar"
                    android:host="channel" />

                <data
                    android:scheme="shiksharojgar"
                    android:host="channel"
                    android:pathPrefix="/post" />

            </intent-filter>

            <!-- Existing website App Link -->
            <intent-filter android:autoVerify="true">

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="www.shiksharojgar.com"
                    android:pathPrefix="/app/channel" />

            </intent-filter>

            <!-- Firebase Hosting App Link -->
            <intent-filter android:autoVerify="true">

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="shiksha-rojgar.web.app"
                    android:pathPrefix="/channel" />

            </intent-filter>

        </activity>

<activity
    android:name=".DangerAdminActivity"
    android:exported="false" />
        
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FileProvider: only ONE provider is required -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.shiksharojgar.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <activity
            android:name=".HomeCategoryActivity" />
<activity
    android:name=".NoticeActivity"
    android:exported="true">

    <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
            android:scheme="shiksharojgar"
            android:host="notice"
            android:pathPrefix="/post" />
    </intent-filter>

    <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
            android:scheme="https"
            android:host="shiksha-rojgar.web.app"
            android:pathPrefix="/notice" />
    </intent-filter>

</activity>
        <activity
            android:name=".GroupAdminActivity"
            android:exported="false" />
                <activity
            android:name=".GroupAuthActivity"
            android:exported="false" />
                        <activity
            android:name=".GroupActivity"
            android:exported="true">

            <!-- Custom link: shiksharojgar://group/post?post=POST_ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="shiksharojgar"
                    android:host="group"
                    android:pathPrefix="/post" />
            </intent-filter>

            <!-- Website link: https://shiksha-rojgar.web.app/group?post=POST_ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="shiksha-rojgar.web.app"
                    android:pathPrefix="/group" />
            </intent-filter>

        </activity>
    </application>

</manifest>
